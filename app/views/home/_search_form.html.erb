<div class="search-container">
  <%= form_with url: rooms_path, method: :get, local: true, class: "search-form" do %>
    <input
      type="text"
      name="q"
      placeholder="エリア・住所・キーワードで検索"
      value="<%= params[:q] %>"
      class="search-input"
    >

    <button type="submit" class="search-button">
      検索
    </button>
  <% end %>
</div>
